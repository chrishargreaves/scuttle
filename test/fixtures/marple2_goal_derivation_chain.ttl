    uco-core:name "File set" ;
    solveit-observable:hasFile kb:chain-file-09b1cc7a-baea-56b0-b09b-dff28f151d6c,
        kb:chain-file-566ef048-76fe-559d-a971-a6fb69d53461,
        kb:chain-file-5f3da40d-e522-5bd7-94c2-352433a9a5fe,
        kb:chain-file-9535b1fa-6705-543e-a719-f49ff1a95d9b,
        kb:chain-file-99ebc6d1-3425-55a9-87bf-272b29ea424a,
        kb:chain-file-9a7eea3e-5e22-539f-884e-fa5246fec137,
        kb:chain-file-d718d7fa-1a47-5111-bada-bec65821a4e4 ;
    uco-core:description "solveit-observable:FileSet — the 'Enumerate files & folders' layer output, produced by Enumerate allocated files and folders (DFT-1060). The 7 file(s) this derivation read from the enumerated file system: the browsers' history stores and the profile-registry files that located them. Scoped to what the later layers consumed, not to every file on the volume. Paths are canonicalised to one form (drive letter, forward slashes) because the contributing techniques record them differently — profile enumeration yields C:/Users/..., history parsing yields C:\\Users\\..., and dissect prefixes a separator on some stores. Without that, one file would appear here as two or three nodes." .

kb:chain-output-browserappfiles-13e2d8ef-f57c-5882-a444-a0d7587d4389 a solveit-observable:BrowserAppFiles ;
    uco-core:name "BrowserAppFiles" ;
    solveit-observable:hasFile kb:chain-file-09b1cc7a-baea-56b0-b09b-dff28f151d6c,
        kb:chain-file-566ef048-76fe-559d-a971-a6fb69d53461,
        kb:chain-file-5f3da40d-e522-5bd7-94c2-352433a9a5fe,
        kb:chain-file-9535b1fa-6705-543e-a719-f49ff1a95d9b,
        kb:chain-file-99ebc6d1-3425-55a9-87bf-272b29ea424a,
        kb:chain-file-9a7eea3e-5e22-539f-884e-fa5246fec137,
        kb:chain-file-d718d7fa-1a47-5111-bada-bec65821a4e4 ;
    uco-core:description "solveit-observable:BrowserAppFiles — the 'Select the browser's files' layer output, produced by Filter files related to an application (DFT-1169). The browser-owned files of the enumerated set. Attributed to 3 browser(s) (Google Chrome, Microsoft Edge, Mozilla Firefox) across 4 profile(s) (Google Chrome / Default; Microsoft Edge / Default; Mozilla Firefox / abcd1234.default-release; Mozilla Firefox / hjdhditw.default), owned by User. Membership matches the FileSet above because every file this derivation read is a browser file — the enumeration was never wider. What this step adds is the attribution, not a reduction." .

